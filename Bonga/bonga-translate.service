[Unit]
Description=Bonga хаб живого перевода (Gemini Live API → субтитры плеера)
Documentation=file:///mnt/Projects/Torrent_Parser/Bonga/gemini-3.5-live-translate.py
# Код и venv лежат на NVMe вместе с плеером: без /mnt/Projects поднимать нечего.
# Дампы синтезированной речи (диагностика озвучки) пишутся на большой диск.
After=network-online.target mnt-Projects.mount mnt-DATA.mount
Wants=network-online.target
RequiresMountsFor=/mnt/Projects/Torrent_Parser/Bonga /mnt/DATA

[Service]
Type=simple
User=vladimir
Group=vladimir
WorkingDirectory=/mnt/Projects/Torrent_Parser/Bonga
Environment=PYTHONUNBUFFERED=1
# Куда писать журнал хаба (translate.log) — journald вывод юнитов тут не собирает.
Environment=BONGA_REC_DIR=/mnt/DATA/Bonga_rec
# Принимает PCM от плеера (ws://LAN:8778) и раздаёт субтитры и озвучку.
# Ключ Gemini читается из config_secrets.py рядом со скриптом (в .gitignore).
# --dump-dir — писать синтез каждой сессии в WAV, чтобы можно было
# прослушать, что именно модель отдаёт (диагностика дубляжа).
ExecStart=/mnt/Projects/Torrent_Parser/Bonga/.venv/bin/python /mnt/Projects/Torrent_Parser/Bonga/gemini-3.5-live-translate.py --serve --dump-dir /mnt/DATA/Bonga_rec/dub-dump
Restart=on-failure
RestartSec=3

# Торчит в LAN, как и плеер; пишет только в journald и дампы диагностики.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/mnt/Projects/Torrent_Parser/Bonga /mnt/DATA/Bonga_rec

[Install]
WantedBy=multi-user.target
