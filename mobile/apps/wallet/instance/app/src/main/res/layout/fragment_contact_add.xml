<?xml version="1.0" encoding="utf-8"?>
<uikit.widget.ColumnLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <uikit.widget.ModalHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/new_contact"/>

    <uikit.widget.ColumnLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/offsetMedium">

        <uikit.widget.InputView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="32"
            android:icon="@drawable/ic_address_book_28"
            android:hint="@string/name"/>

        <uikit.widget.AsyncImageView
            android:id="@+id/photo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/offsetMedium"
            android:visibility="gone"
            app:roundAsCircle="true"/>

        <Button
            style="@style/Widget.App.Button.Medium.Secondary"
            android:id="@+id/create_phone_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/offsetExtraSmall"
            android:textAppearance="@style/TextAppearance.Label2"
            android:text="@string/create_phone_contact"/>

        <uikit.widget.InputView
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/offsetMedium"
            android:hint="@string/wallet_address"/>

        <Button
            style="@style/Widget.App.Button"
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/offsetMedium"
            android:textAppearance="@style/TextAppearance.Label1"
            android:text="@string/save"/>

    </uikit.widget.ColumnLayout>

</uikit.widget.ColumnLayout>